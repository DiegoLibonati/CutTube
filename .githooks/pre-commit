#!/bin/sh
# Pre-commit hook for Cut Tube monorepo.
# Runs ruff and mypy when cut-tube-api files are staged.
# Runs lint-staged when cut-tube-app files are staged.

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

API_FILES=$(echo "$STAGED_FILES" | grep "^cut-tube-api/")
APP_FILES=$(echo "$STAGED_FILES" | grep "^cut-tube-app/")

EXIT_CODE=0

if [ -n "$API_FILES" ]; then
    INSTALL_PYTHON="$REPO_ROOT/cut-tube-api/venv/Scripts/python.exe"

    if [ ! -x "$INSTALL_PYTHON" ]; then
        echo '[pre-commit] venv python not found at cut-tube-api/venv/. Did you create the virtualenv?' 1>&2
        exit 1
    fi

    echo "[pre-commit] Running ruff check for cut-tube-api..."
    "$INSTALL_PYTHON" -m ruff check --fix "$REPO_ROOT/cut-tube-api"
    EXIT_CODE=$((EXIT_CODE + $?))

    echo "[pre-commit] Running ruff format for cut-tube-api..."
    "$INSTALL_PYTHON" -m ruff format "$REPO_ROOT/cut-tube-api"
    EXIT_CODE=$((EXIT_CODE + $?))

    echo "[pre-commit] Running mypy for cut-tube-api..."
    "$INSTALL_PYTHON" -m mypy \
        --config-file="$REPO_ROOT/cut-tube-api/pyproject.toml" \
        "$REPO_ROOT/cut-tube-api"
    EXIT_CODE=$((EXIT_CODE + $?))
fi

if [ -n "$APP_FILES" ]; then
    echo "[pre-commit] Running lint-staged for cut-tube-app..."
    if command -v npx > /dev/null; then
        (cd "$REPO_ROOT/cut-tube-app" && npx --no-install lint-staged)
    else
        echo '[pre-commit] `npx` not found. Did you install Node.js?' 1>&2
        exit 1
    fi
    EXIT_CODE=$((EXIT_CODE + $?))
fi

exit $EXIT_CODE
